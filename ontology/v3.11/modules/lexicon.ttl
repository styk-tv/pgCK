@prefix lex:  <https://conceptkernel.org/ontology/v3.11/lexicon#> .
@prefix wave: <https://conceptkernel.org/ontology/v3.11/wave#> .
@prefix ckp:  <https://conceptkernel.org/ontology/v3.11/core#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#######################################################################
# CKP v3.11 — LEXICON MODULE
#
# The dictionary of successes and failures, built so that MATERIALIZING
# an epoch produces the constructs the next epoch needs.
#
# THE DIVISION OF LABOUR, AND IT IS THE WHOLE DESIGN:
#
#   a component ASSERTS   one flat, observable fact — a symptom IRI.
#                         No judgement, no classification, no naming.
#   the reasoner DERIVES  what kind of thing it is, what it implicates,
#                         and what it is downstream of.
#   a query COUNTS        and only counts. Thresholds live outside OWL.
#
# A component that must decide "is this a vacuity or a fail-open?" will
# decide inconsistently across nine repositories and twenty passes. A
# component that must answer "did the gate refuse, or did it report?"
# will answer the same way every time. THE VOCABULARY IS BUILT SO THAT
# ONLY THE SECOND KIND OF QUESTION IS EVER ASKED.
#
# MEASURED ENTAILMENT BUDGET — pgrdf.materialize(g,'owl-rl'), 0.6.22,
# probed rather than assumed:
#
#   owl:hasValue restriction      DERIVED   classification
#   owl:someValuesFrom            DERIVED   classification from a link
#   owl:TransitiveProperty        DERIVED   causal / blocking closure
#   owl:inverseOf                 DERIVED   one write, two facts
#   owl:equivalentClass           DERIVED   alignment
#   rdfs:subClassOf transitivity  DERIVED   hierarchy
#   owl:propertyChainAxiom        DERIVED — with `prp-spo2`, see LEX-1
#   counting                      structurally absent from OWL RL
#
# NOTHING IN THIS FILE DEPENDS ON AN UNMEASURED ENTAILMENT.
#
# LEX-2 — EVERY PATTERN QUERY MUST FILTER isIRI. Declaring
# `owl:equivalentClass [ a owl:Restriction ... ]` makes the anonymous
# restriction a subclass of lex:Pattern too, so an unfiltered query
# returns each pattern twice: once named, once as a blank node with the
# identical instance count. Measured, not predicted. The canonical form
# is in §7 and it carries the filter.
#
# LEX-1 — CHAINED ATTRIBUTION, AND WHAT IT REQUIRES.
# The rule `prp-spo2` (`owl:propertyChainAxiom`, general n-hop) is
# implemented on the `feat/prp-spo2-property-chain-axiom` branch of the
# reasoner and is FEATURE-GATED, off by default.
#
#   reasonable = { git = "…/reasonable",
#                  branch = "feat/prp-spo2-property-chain-axiom",
#                  features = ["rdf-12", "prp-spo2"] }
#
# MEASURED, not assumed, on that branch:
#   feature OFF        100 tests pass — upstream behaviour unchanged
#   feature ON         115 pass, 0 fail — strictly additive
#   rdf-12 + prp-spo2  115 pass — the combination this stack needs
#   2-hop and 3-hop chains both derive; with the feature off the same
#   fixture derives nothing, which is the control.
#
# UNTIL THE ENGINE SHIPS THAT FEATURE, §5.1 DERIVES NOTHING. Stated
# here rather than discovered later: a chain axiom under an engine
# without the rule is a well-formed constraint that is never evaluated,
# and this file exists to name that condition, not to produce it.
#######################################################################

<https://conceptkernel.org/ontology/v3.11/lexicon> a owl:Ontology ;
  rdfs:label "CKP Wave Lexicon v3.11" ;
  rdfs:comment "The controlled vocabulary of what goes right and wrong in a coordination wave, with the OWL axioms that classify it at materialization time." .


#######################################################################
# 1. SYMPTOMS — the only thing a component writes
#
# Closed set. Each is phrased as an OBSERVATION, never a diagnosis:
# what was seen, not what it means. One symptom per defect.
#######################################################################

lex:symptom a owl:ObjectProperty ;
  rdfs:domain wave:Defect ; rdfs:range lex:Symptom ;
  rdfs:comment "The one observable this defect presented. Chosen from a closed set by answering a question of fact, never of judgement. The pattern it belongs to is derived, not asserted." .

lex:Symptom a rdfs:Class ;
  rdfs:label "Symptom" ;
  rdfs:comment "An observation a component can make without interpreting it." .

lex:sym-reports-not-refuses a lex:Symptom ;
  rdfs:label "the check ran, reported, and admitted the thing it should have refused" .
lex:sym-passes-vacuously a lex:Symptom ;
  rdfs:label "the check is present and well-formed and was never evaluated" .
lex:sym-present-not-wired a lex:Symptom ;
  rdfs:label "the artifact exists and is absent from the build path" .
lex:sym-cited-after-move a lex:Symptom ;
  rdfs:label "a digest was cited after the artifact it names had changed" .
lex:sym-published-uncounted a lex:Symptom ;
  rdfs:label "a quantity was published without being counted" .
lex:sym-named-for-finder a lex:Symptom ;
  rdfs:label "the thing is named for where it was found rather than where it is fixed" .
lex:sym-gate-unread a lex:Symptom ;
  rdfs:label "the gate produced the correct output and its reader drew the wrong conclusion" .
lex:sym-claim-unmeasured a lex:Symptom ;
  rdfs:label "a consequence was asserted from a cause without measuring the consequence" .
lex:sym-step-absent a lex:Symptom ;
  rdfs:label "a step the sequence depends on does not exist" .


#######################################################################
# 2. PATTERNS — derived at materialize. Nobody writes these.
#
# Each is an owl:hasValue restriction over lex:symptom, which the
# engine is MEASURED to derive. Asserting a symptom makes the defect an
# instance of its pattern with no further work by anyone.
#######################################################################

lex:Pattern a rdfs:Class ;
  rdfs:label "Pattern" ;
  rdfs:comment "A recurring shape of failure. Membership is inferred from the symptom; a pattern is never asserted of an instance." .

lex:FalseGate a owl:Class ; rdfs:subClassOf lex:Pattern ;
  rdfs:label "false gate — it reports and does not refuse" ;
  owl:equivalentClass [ a owl:Restriction ;
    owl:onProperty lex:symptom ; owl:hasValue lex:sym-reports-not-refuses ] .

lex:VacuousGate a owl:Class ; rdfs:subClassOf lex:Pattern ;
  rdfs:label "vacuous gate — well-formed and never evaluated" ;
  owl:equivalentClass [ a owl:Restriction ;
    owl:onProperty lex:symptom ; owl:hasValue lex:sym-passes-vacuously ] .

lex:BenchOnly a owl:Class ; rdfs:subClassOf lex:Pattern ;
  rdfs:label "bench-only — enforced here, absent from a release" ;
  owl:equivalentClass [ a owl:Restriction ;
    owl:onProperty lex:symptom ; owl:hasValue lex:sym-present-not-wired ] .

lex:StaleCitation a owl:Class ; rdfs:subClassOf lex:Pattern ;
  rdfs:label "stale citation — the artifact moved and the digest stood" ;
  owl:equivalentClass [ a owl:Restriction ;
    owl:onProperty lex:symptom ; owl:hasValue lex:sym-cited-after-move ] .

lex:UncountedClaim a owl:Class ; rdfs:subClassOf lex:Pattern ;
  rdfs:label "uncounted claim — a number published without counting" ;
  owl:equivalentClass [ a owl:Restriction ;
    owl:onProperty lex:symptom ; owl:hasValue lex:sym-published-uncounted ] .

lex:Misattribution a owl:Class ; rdfs:subClassOf lex:Pattern ;
  rdfs:label "misattribution — named for the finder, not the fixer" ;
  owl:equivalentClass [ a owl:Restriction ;
    owl:onProperty lex:symptom ; owl:hasValue lex:sym-named-for-finder ] .

lex:UnreadGate a owl:Class ; rdfs:subClassOf lex:Pattern ;
  rdfs:label "unread gate — the instrument was right and the reader was not" ;
  owl:equivalentClass [ a owl:Restriction ;
    owl:onProperty lex:symptom ; owl:hasValue lex:sym-gate-unread ] .

lex:UnmeasuredConsequence a owl:Class ; rdfs:subClassOf lex:Pattern ;
  rdfs:label "unmeasured consequence — reasoned from cause, never checked" ;
  owl:equivalentClass [ a owl:Restriction ;
    owl:onProperty lex:symptom ; owl:hasValue lex:sym-claim-unmeasured ] .

lex:BrokenSequence a owl:Class ; rdfs:subClassOf lex:Pattern ;
  rdfs:label "broken sequence — a depended-on step does not exist" ;
  owl:equivalentClass [ a owl:Restriction ;
    owl:onProperty lex:symptom ; owl:hasValue lex:sym-step-absent ] .


#######################################################################
# 3. OUTCOMES — what became of an act
#
# The success half of the dictionary. Without it the wave can only
# count what went wrong, and a record that only counts failure teaches
# a component to stop reporting.
#######################################################################

lex:outcome a owl:ObjectProperty ;
  rdfs:domain wave:Operation ; rdfs:range lex:Outcome ;
  rdfs:comment "What became of the act, recorded at the pass that settled it — not at the pass that performed it." .

lex:Outcome a rdfs:Class ; rdfs:label "Outcome" .

lex:out-held        a lex:Outcome ; rdfs:label "held — measured again later and still true" .
lex:out-refuted     a lex:Outcome ; rdfs:label "refuted — a later measurement falsified it" .
lex:out-partial     a lex:Outcome ; rdfs:label "partial — true in part, and the remainder was load-bearing" .
lex:out-superseded  a lex:Outcome ; rdfs:label "superseded — correct then, replaced since" .
lex:out-unsettled   a lex:Outcome ; rdfs:label "unsettled — no second measurement yet" .

lex:HeldAct a owl:Class ;
  rdfs:label "an act that survived a second measurement" ;
  owl:equivalentClass [ a owl:Restriction ;
    owl:onProperty lex:outcome ; owl:hasValue lex:out-held ] .

lex:RefutedAct a owl:Class ;
  rdfs:label "an act a later measurement falsified" ;
  owl:equivalentClass [ a owl:Restriction ;
    owl:onProperty lex:outcome ; owl:hasValue lex:out-refuted ] .


#######################################################################
# 4. CHAINS AND INVERSES — the two things the reasoner gives for free
#
# Transitivity is measured DERIVED, so a root cause and a full blocking
# closure appear at materialize rather than being traced by hand.
# Inverses are measured DERIVED, so every confirmation is filed once
# and readable from both ends — which removes an entire class of
# asymmetric-record defect rather than gating against it.
#######################################################################

lex:causedBy a owl:ObjectProperty , owl:TransitiveProperty ;
  rdfs:comment "This defect exists because that one does. Transitive: materialize surfaces the root of a chain nobody traced. No rdfs:domain — a defect, an operation or a ticket may each be a cause." .

lex:blocks a owl:ObjectProperty , owl:TransitiveProperty ;
  rdfs:comment "Transitive by construction, so a component two hops from the real blocker is visible without anyone drawing the graph." .

lex:blockedBy a owl:ObjectProperty ;
  owl:inverseOf lex:blocks ;
  rdfs:comment "Derived. Never asserted — assert lex:blocks and read this." .

lex:confirmedBy a owl:ObjectProperty ;
  owl:inverseOf wave:confirmsTicket ;
  rdfs:comment "Derived from the confirmation. A ticket knows who measured it without the ticket being edited, which is what makes confirmation cheap enough to actually do." .

#######################################################################
# 5.1 CHAINED ATTRIBUTION — n-hop, requires `prp-spo2`
#
# One assertion per fact, and the composition is derived. Without the
# rule a component must assert `defectOwner` by hand on every defect,
# which is a fact they can get wrong; with it, ownership follows from
# where the defect is and who owns that, both of which are already
# recorded for other reasons.
#
# This is the first place the lexicon asks the reasoner for something a
# component would otherwise have to remember.
#######################################################################

lex:defectIn a owl:ObjectProperty ;
  rdfs:domain wave:Defect ;
  rdfs:comment "The artifact this defect is in — a file, a routine, a shape, a PR." .

lex:defectOwner a owl:ObjectProperty ;
  owl:propertyChainAxiom ( lex:defectIn wave:owner ) ;
  rdfs:comment "Derived: the component owning the artifact the defect is in. Never asserted. Requires prp-spo2." .

lex:confirmedTicketOwner a owl:ObjectProperty ;
  owl:propertyChainAxiom ( wave:confirmsTicket wave:owner ) ;
  rdfs:comment "Derived: whose ticket a confirmation measured. Makes 'who confirmed whom' a query rather than a reading. Requires prp-spo2." .

lex:passDirector a owl:ObjectProperty ;
  owl:propertyChainAxiom ( wave:forPass wave:director ) ;
  rdfs:comment "Derived: the director of the pass an index was filed for. Requires prp-spo2." .


lex:recurrenceOf a owl:ObjectProperty ;
  rdfs:domain wave:Defect ; rdfs:range lex:Pattern ;
  rdfs:comment "Asserted only when a component recognises a repeat before the reasoner classifies it. Redundant with the derived membership by design: a human noticing a repetition is itself worth recording." .


#######################################################################
# 5. RULES — what a pattern earns, and how it can lose
#
# The output of a learning epoch. A rule that cannot be refuted is not
# a rule the wave learned; it is a rule the wave asserted, and the
# difference is the entire point of recording confidence.
#######################################################################

lex:Rule a rdfs:Class ;
  rdfs:subClassOf ckp:Instance ;
  rdfs:label "Derived Rule" ;
  rdfs:comment "A constraint a pattern earned by recurring. Carries the pattern it came from, the pass that proposed it, and — if a measurement ever falsifies it — the pass that killed it." .

lex:fromPattern a owl:ObjectProperty ;
  rdfs:domain lex:Rule ; rdfs:range lex:Pattern .

lex:instancesAtProposal a owl:DatatypeProperty ;
  rdfs:domain lex:Rule ; rdfs:range xsd:integer ;
  rdfs:comment "How many instances the pattern had when the rule was proposed. The prior, stated — so a rule earned on three instances is never mistaken for one earned on thirty." .

lex:ruleState a owl:DatatypeProperty ;
  rdfs:domain lex:Rule ;
  rdfs:comment "proposed · active · refuted · retired. refuted is the outcome that makes the rest honest." .

lex:proposedAtPass a owl:DatatypeProperty ;
  rdfs:domain lex:Rule ; rdfs:range xsd:integer .

lex:refutedAtPass a owl:DatatypeProperty ;
  rdfs:domain lex:Rule ; rdfs:range xsd:integer ;
  rdfs:comment "Absent while the rule stands. Present, it is the wave's own correction rate — the number that separates learning from accumulation." .

lex:enforcedBy a owl:DatatypeProperty ;
  rdfs:domain lex:Rule ;
  rdfs:comment "Where the rule became mechanical: a shape name, a script, a CI check. A rule with no enforcement is a sentence, which is the condition v3.11 exists to end." .


#######################################################################
# 6. SHAPES
#######################################################################

lex:SymptomShape a sh:NodeShape ;
  sh:targetClass lex:Symptom ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

lex:OutcomeShape a sh:NodeShape ;
  sh:targetClass lex:Outcome ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

lex:PatternShape a sh:NodeShape ;
  sh:targetClass lex:Pattern ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

lex:RuleShape a sh:NodeShape ;
  sh:targetClass lex:Rule ;
  sh:property [ sh:path rdfs:label            ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lex:fromPattern       ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path lex:instancesAtProposal ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path lex:proposedAtPass    ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path lex:enforcedBy        ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path lex:ruleState         ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( "proposed" "active" "refuted" "retired" ) ] ;
  sh:property [ sh:path lex:refutedAtPass     ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

#######################################################################
# 6b. ASSERTION GATES — wave-3.12 revision. The closed sets §1/§3 declare
# were prose to the gate: a Finding carrying
#   lex:symptom <urn:not:a:declared:symptom>
# SEALED (measured live over the wire, 2026-08-26 — the seven-constants
# defect class, in the module the fleet's finding discipline leans on
# most). These two shapes end that. Both select by sh:targetSubjectsOf —
# they gate whoever ASSERTS the property and demand nothing of anyone
# else, so no emission path gains a required property it cannot produce
# (the §6 emission-and-shape rule).
#
#   AssertionGateShape   the asserted vocabulary: symptom and outcome
#                        values from their closed sets; the link
#                        properties IRI-kinded; recurrenceOf from the
#                        declared patterns.
#   DerivedOnlyShape     the five derived properties may never be
#                        ASSERTED (maxCount 0). The seal gate sees only
#                        asserted bodies — derived quads appear at
#                        materialize and never pass through it — so
#                        "never asserted, always derived" is now a
#                        refusal, not a comment.
#######################################################################

lex:AssertionGateShape a sh:NodeShape ;
  sh:targetSubjectsOf lex:symptom ;
  sh:targetSubjectsOf lex:outcome ;
  sh:targetSubjectsOf lex:recurrenceOf ;
  sh:targetSubjectsOf lex:causedBy ;
  sh:targetSubjectsOf lex:blocks ;
  sh:targetSubjectsOf lex:defectIn ;
  sh:property [ sh:path lex:symptom ; sh:nodeKind sh:IRI ;
    sh:in ( lex:sym-reports-not-refuses lex:sym-passes-vacuously
            lex:sym-present-not-wired lex:sym-cited-after-move
            lex:sym-published-uncounted lex:sym-named-for-finder
            lex:sym-gate-unread lex:sym-claim-unmeasured lex:sym-step-absent ) ;
    sh:message "lex:symptom is a closed set — choose one of the nine declared symptom IRIs; a symptom outside the set is a diagnosis, and components do not diagnose" ] ;
  sh:property [ sh:path lex:outcome ; sh:nodeKind sh:IRI ;
    sh:in ( lex:out-held lex:out-refuted lex:out-partial
            lex:out-superseded lex:out-unsettled ) ;
    sh:message "lex:outcome is a closed set — held, refuted, partial, superseded or unsettled" ] ;
  sh:property [ sh:path lex:recurrenceOf ; sh:nodeKind sh:IRI ;
    sh:in ( lex:FalseGate lex:VacuousGate lex:BenchOnly lex:StaleCitation
            lex:UncountedClaim lex:Misattribution lex:UnreadGate
            lex:UnmeasuredConsequence lex:BrokenSequence ) ;
    sh:message "lex:recurrenceOf names one of the nine declared patterns" ] ;
  sh:property [ sh:path lex:causedBy ; sh:nodeKind sh:IRI ;
    sh:message "lex:causedBy names a resource, never a literal" ] ;
  sh:property [ sh:path lex:blocks ; sh:nodeKind sh:IRI ;
    sh:message "lex:blocks names a resource, never a literal" ] ;
  sh:property [ sh:path lex:defectIn ; sh:nodeKind sh:IRI ;
    sh:message "lex:defectIn names the artifact as an IRI" ] .

lex:DerivedOnlyShape a sh:NodeShape ;
  sh:targetSubjectsOf lex:blockedBy ;
  sh:targetSubjectsOf lex:confirmedBy ;
  sh:targetSubjectsOf lex:defectOwner ;
  sh:targetSubjectsOf lex:confirmedTicketOwner ;
  sh:targetSubjectsOf lex:passDirector ;
  sh:property [ sh:path lex:blockedBy ; sh:maxCount 0 ;
    sh:message "lex:blockedBy is derived — assert lex:blocks and read this" ] ;
  sh:property [ sh:path lex:confirmedBy ; sh:maxCount 0 ;
    sh:message "lex:confirmedBy is derived from wave:confirmsTicket — file the confirmation" ] ;
  sh:property [ sh:path lex:defectOwner ; sh:maxCount 0 ;
    sh:message "lex:defectOwner is derived (defectIn ∘ owner) — assert lex:defectIn" ] ;
  sh:property [ sh:path lex:confirmedTicketOwner ; sh:maxCount 0 ;
    sh:message "lex:confirmedTicketOwner is derived (confirmsTicket ∘ owner)" ] ;
  sh:property [ sh:path lex:passDirector ; sh:maxCount 0 ;
    sh:message "lex:passDirector is derived (forPass ∘ director)" ] .


#######################################################################
# 7. THE EPOCH LOOP — what this file is for
#
#   ε     components assert symptoms and outcomes. Flat facts only.
#   ─     pgrdf.materialize(g,'owl-rl')
#         -> every defect gains its pattern
#         -> every causal chain gains its root
#         -> every confirmation becomes readable from both ends
#   ─     ONE query counts instances per pattern — WITH isIRI, see LEX-2:
#
#           SELECT ?p WHERE { GRAPH <g> { ?d a ?p .
#             ?p rdfs:subClassOf lex:Pattern . FILTER(isIRI(?p)) } }
#
#         Counting is the only step OWL RL cannot take, so it is the
#         only step left outside.
#   ─     a pattern over threshold proposes a lex:Rule carrying its
#         instance count as a stated prior
#   ε+1   the rule is enforced somewhere nameable, and can be refuted
#
# The wave becomes a concept kernel whose subject matter is the wave.
# CK is this lexicon. TOOL is the reasoner. DATA is the sealed record
# of what went right and wrong. That is not an analogy — it is the same
# three organs, and the same materialization, applied to ourselves.
#
# WHAT A COMPONENT MUST WRITE, IN FULL:
#   <defect> lex:symptom lex:sym-reports-not-refuses .
# Everything else in this file is derived, counted or proposed.
#######################################################################
