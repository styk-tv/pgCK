        <mxCell id="wWave" value="Wave  a bounded coordination campaign across several components" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="190" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wPass" value="Pass  ofWave · director AN EPOCH — it names the surface in force. No proof, no record." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="190" width="360" height="130" as="geometry" />
