        <mxCell id="eb5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=0;fontSize=19;" parent="1" source="DATA" target="Organ" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;strokeColor=#82b366;strokeWidth=2;dashed=1;fontSize=19;" parent="1" source="TOOL" target="CK" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb6L" value="dependsOn" style="edgeLabel;html=1;fontSize=19;fontColor=#82b366;labelBackgroundColor=#FFFFFF;" parent="eb6" vertex="1" connectable="0">
