        <mxCell id="wRest" value="Defect  defectKind · defectState · discoveredAtPass · resolvedAtPass Ruling  ruledAtPass · refutedAtPass Operation  opKind · opTarget · opEvidence · supersedes Index  role · capacity · measuredOn · measuredAgainst · blockedOn · needHelp Statement  bindsRoot · rebasedAtPass" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=16;" vertex="1" parent="1">
