        </mxCell>
        <mxCell id="ovA" value="A  IDENTITY &amp; AUTHORITY  who acted, for whom, with what permission" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ovB" value="B  STRUCTURE  a kernel is a project with three organs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ovC" value="C  THE SEALED FACT  provenance as a consequence, never a claim" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="150" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ovD" value="D  SURFACE &amp; EXECUTION  what a kernel may do, and where results go" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="150" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ovE" value="E  GOVERNED PLANE  propose → vote → apply, and the epoch it seals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1840" y="150" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ovF" value="F  ADOPTION  a module joins the surface only by sealed digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="400" height="180" as="geometry" />
