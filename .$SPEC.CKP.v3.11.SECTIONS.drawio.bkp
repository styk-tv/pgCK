        </mxCell>
        <mxCell id="ew3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="wComp" target="wTick">
