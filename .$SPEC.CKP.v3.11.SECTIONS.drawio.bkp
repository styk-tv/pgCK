        <mxCell id="pa" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1450" y="180" width="1050" height="760" as="geometry" />
