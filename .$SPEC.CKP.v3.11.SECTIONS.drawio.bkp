        <mxCell id="T" value="CKP v3.11 — the six clusters and two adopted modules" style="text;html=1;fontSize=22;align=left;fontColor=#000000;fontStyle=1;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="2000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="S" value="One tab per section. Everything is read from the loaded graphs, not from memory: core e5f7d1e5… · wave f4ad27ce… · lexicon ce9f20f4…" style="text;html=1;fontSize=13;align=left;fontColor=#555555;fontStyle=1;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
