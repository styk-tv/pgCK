        <mxCell id="ew1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="wFind" target="wTick">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ew1L" value="promotedTo — EXPLICIT" style="edgeLabel;html=1;fontSize=11;fontColor=#d79b00;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="ew1">
          <mxGeometry x="0" relative="1" as="geometry">
