        <mxCell id="ew2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="wConf" target="wTick">
          <mxGeometry relative="1" as="geometry" />
