        <mxCell id="eb4L" value="rdfs:subClassOf" style="edgeLabel;html=1;fontSize=19;fontColor=#82b366;labelBackgroundColor=#FFFFFF;" parent="eb4" vertex="1" connectable="0">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
