        <mxCell id="wFind" value="Finding  label · reason · findingState  MEASURED, NOT WORK unowned · unscheduled" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
