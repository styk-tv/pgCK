        <mxCell id="wConf" value="Confirmation  confirmsTicket · evidence  A SECOND component measuring a ticket it does NOT own" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="600" width="340" height="160" as="geometry" />
