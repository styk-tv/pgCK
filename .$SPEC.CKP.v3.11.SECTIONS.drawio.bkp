        <mxCell id="wComp" value="Component  repository · statement holds exactly ONE ticket per pass" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
