        <mxCell id="S" value="A kernel is a project with three organs and counted dependencies — the count IS the axiom" style="text;html=1;fontSize=13;align=left;fontColor=#6c8ebf;fontStyle=1;verticalAlign=top;whiteSpace=wrap;" parent="1" vertex="1">
