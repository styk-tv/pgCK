          <mxGeometry x="60" y="30" width="2000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="S" value="urn:ckp:module/wave/v3.11 — adopted by digest f4ad27ce… — passes, tickets, findings, confirmations, rulings" style="text;html=1;fontSize=13;align=left;fontColor=#82b366;fontStyle=1;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="2200" height="24" as="geometry" />
